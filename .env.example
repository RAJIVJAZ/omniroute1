# Minimal OmniRoute configuration. Run `./scripts/setup.sh` to create .env
# with generated secrets. The full upstream reference (~3,500 lines) ships in
# the npm package as node_modules/omniroute/.env.example.

# ── Required secrets (setup.sh fills these) ─────────────────────────────────
JWT_SECRET=
API_KEY_SECRET=
STORAGE_ENCRYPTION_KEY=
STORAGE_ENCRYPTION_KEY_VERSION=v1
# Initial dashboard password; change it after first login.
INITIAL_PASSWORD=CHANGEME

# ── Server ──────────────────────────────────────────────────────────────────
PORT=20128
NODE_ENV=production
BASE_URL=http://localhost:20128
NEXT_PUBLIC_BASE_URL=http://localhost:20128
# Set to true when serving over HTTPS.
AUTH_COOKIE_SECURE=false
# Require an OmniRoute API key on /v1/* requests (recommended when exposed).
REQUIRE_API_KEY=false

# ── Docker only ─────────────────────────────────────────────────────────────
# OMNIROUTE_VERSION=3.8.51
# OMNIROUTE_BIND=127.0.0.1
# V8 heap in MB: 1024 for dashboard/light chat, 8192 for one coding agent.
# OMNIROUTE_MEMORY_MB=1024

# ── npm only ────────────────────────────────────────────────────────────────
# Where the SQLite DB, logs and backups live (Docker uses a named volume).
DATA_DIR=./data
